# Copy this file to .env for local development. Never commit .env or real secrets.
#
# GK2A point-DSR API key. Required only by the future Stage 4 worker and the
# local scripts/verify_gk2a_dsr.py integration check.
KMA_API_KEY=replace_with_your_kma_api_hub_key

# Open-Meteo currently uses the existing public default endpoint and needs no
# key or .env setting. Do not add credentials for it here.
