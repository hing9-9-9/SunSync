  "components": {
    "schemas": {
      "Alignment": {
        "properties": {
          "T_enu_board": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 16,
            "title": "T Enu Board"
          },
          "north_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "North Confirmed"
          },
          "floor_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Floor Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "T_enu_board",
          "north_confirmed",
          "floor_confirmed"
        ],
        "title": "Alignment"
      },
      "Board": {
        "properties": {
          "board_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Board Id"
          },
          "dictionary": {
            "type": "string",
            "const": "DICT_4X4_50",
            "title": "Dictionary",
            "default": "DICT_4X4_50"
          },
          "ids_by_row": {
            "prefixItems": [
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Ids By Row",
            "default": [
              [
                7,
                8
              ],
              [
                9,
                10
              ]
            ]
          },
          "marker_side_m": {
            "type": "number",
            "maximum": 5.0,
            "exclusiveMinimum": 0.0,
            "title": "Marker Side M"
          },
          "gap_x_m": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Gap X M"
          },
          "gap_y_m": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Gap Y M"
          },
          "border_bits": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Border Bits",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "board_id",
          "marker_side_m",
          "gap_x_m",
          "gap_y_m"
        ],
        "title": "Board"
      },
      "Camera": {
        "properties": {
          "width": {
            "type": "integer",
            "maximum": 8192.0,
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "maximum": 8192.0,
            "exclusiveMinimum": 0.0,
            "title": "Height"
          },
          "fx": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Fx"
          },
          "fy": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Fy"
          },
          "cx": {
            "type": "number",
            "title": "Cx"
          },
          "cy": {
            "type": "number",
            "title": "Cy"
          },
          "pixel_space": {
            "type": "string",
            "enum": [
              "raw_opencv",
              "rectified"
            ],
            "title": "Pixel Space"
          },
          "distortion": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Distortion"
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "lens_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Lens Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "height",
          "fx",
          "fy",
          "cx",
          "cy",
          "pixel_space",
          "distortion",
          "source",
          "lens_id"
        ],
        "title": "Camera"
      },
      "Capture": {
        "properties": {
          "capture_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Capture Id"
          },
          "point_id": {
            "type": "string",
            "title": "Point Id"
          },
          "camera": {
            "$ref": "#/components/schemas/Camera"
          },
          "detections": {
            "items": {
              "$ref": "#/components/schemas/Detection"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Detections"
          },
          "camera_to_point_m": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Camera To Point M",
            "default": [
              0,
              0,
              0
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "capture_id",
          "point_id",
          "camera",
          "detections"
        ],
        "title": "Capture"
      },
      "DetectRequest": {
        "properties": {
          "camera": {
            "$ref": "#/components/schemas/Camera"
          },
          "board": {
            "$ref": "#/components/schemas/Board"
          },
          "image_base64": {
            "type": "string",
            "maxLength": 12000000,
            "minLength": 1,
            "title": "Image Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "camera",
          "board",
          "image_base64"
        ],
        "title": "DetectRequest"
      },
      "Detection": {
        "properties": {
          "marker_id": {
            "type": "integer",
            "maximum": 49.0,
            "minimum": 0.0,
            "title": "Marker Id"
          },
          "corners_px": {
            "prefixItems": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              }
            ],
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Corners Px"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "marker_id",
          "corners_px"
        ],
        "title": "Detection"
      },
      "Floor": {
        "properties": {
          "board_origin_height_m": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Board Origin Height M"
          },
          "up_board": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Up Board"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "board_origin_height_m",
          "up_board"
        ],
        "title": "Floor"
      },
      "FragmentRequest": {
        "properties": {
          "measurement": {
            "additionalProperties": true,
            "type": "object",
            "title": "Measurement"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "measurement"
        ],
        "title": "FragmentRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeasureRequest": {
        "properties": {
          "plan": {
            "$ref": "#/components/schemas/PlanRequest"
          },
          "board": {
            "$ref": "#/components/schemas/Board"
          },
          "captures": {
            "items": {
              "$ref": "#/components/schemas/Capture"
            },
            "type": "array",
            "maxItems": 85,
            "minItems": 1,
            "title": "Captures"
          },
          "floor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Floor"
              },
              {
                "type": "null"
              }
            ]
          },
          "alignment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Alignment"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_repeat_spread_m": {
            "type": "number",
            "maximum": 0.1,
            "exclusiveMinimum": 0.0,
            "title": "Max Repeat Spread M",
            "default": 0.03
          },
          "max_surface_residual_m": {
            "type": "number",
            "maximum": 0.1,
            "exclusiveMinimum": 0.0,
            "title": "Max Surface Residual M",
            "default": 0.03
          },
          "max_reprojection_rmse_px": {
            "type": "number",
            "maximum": 5.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Reprojection Rmse Px",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "plan",
          "board",
          "captures"
        ],
        "title": "MeasureRequest"
      },
      "PlanRequest": {
        "properties": {
          "space_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Space Id"
          },
          "furniture_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Furniture Id"
          },
          "furniture_kind": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Furniture Kind"
          },
          "model_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model Id"
          },
          "shape": {
            "$ref": "#/components/schemas/Shape"
          },
          "samples_per_point": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Samples Per Point",
            "default": 3
          },
          "height_mode": {
            "type": "string",
            "enum": [
              "surface_is_top",
              "capture_highest",
              "manual"
            ],
            "title": "Height Mode",
            "default": "surface_is_top"
          },
          "manual_height_m": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Manual Height M"
          },
          "floor_supported": {
            "type": "boolean",
            "title": "Floor Supported",
            "default": true
          },
          "manual_base_height_m": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Manual Base Height M"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "space_id",
          "furniture_id",
          "furniture_kind",
          "model_id",
          "shape"
        ],
        "title": "PlanRequest"
      },
      "SceneRequest": {
        "properties": {
          "measurements": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "title": "Measurements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "measurements"
        ],
        "title": "SceneRequest"
      },
      "Shape": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "rectangle",
              "circle",
              "ellipse",
              "polygon"
            ],
            "title": "Kind"
          },
          "vertices": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 16,
            "title": "Vertices"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Shape"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}