# Copy to /etc/sunsync/sunsync.env (mode 600). Never commit the real file.
# One absolute database file shared by the API and the forecast worker.
SUNSYNC_DATABASE_URL=sqlite:////var/lib/sunsync/sunsync.db
# Public address of the site; the QR code that opens the phone app is built from it.
VITE_PUBLIC_URL=https://YOUR_NAME.duckdns.org
