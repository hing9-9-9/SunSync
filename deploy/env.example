# Copy to /etc/sunsync/sunsync.env (mode 600). Never commit the real file.
# One absolute database file shared by the API and the forecast worker.
SUNSYNC_DATABASE_URL=sqlite:////var/lib/sunsync/sunsync.db
# Public address of the site; the QR code that opens the phone app is built from it.
VITE_PUBLIC_URL=https://YOUR_NAME.duckdns.org

# Google login (see docs/auth.md). Leave SUNSYNC_AUTH out to keep the login off.
# Turn it on only after the screen change that uses it is deployed.
# SUNSYNC_AUTH=google
# SUNSYNC_GOOGLE_CLIENT_ID=
# SUNSYNC_GOOGLE_CLIENT_SECRET=
# Exactly the address in the browser, without a slash at the end.
# SUNSYNC_PUBLIC_URL=https://YOUR_NAME.duckdns.org
# The session ends after this many minutes without use, and in any case after this many hours.
# SUNSYNC_SESSION_IDLE_MINUTES=30
# SUNSYNC_SESSION_MAX_HOURS=12
