# Copy to /etc/caddy/Caddyfile and replace YOUR_NAME (see docs/deploy.md).

# The Google login is the lock (docs/auth.md). The API checks the login itself. /measure is a
# separate program, so Caddy asks the API who is logged in before a request reaches it.
# /api/auth/check answers 401 also when the login is off, so a server whose login is not switched
# on yet keeps /measure closed instead of open.
(login) {
	forward_auth 127.0.0.1:8000 {
		uri /api/auth/check
	}
}

# Temporary lock for a server whose Google login is not ready yet: run "caddy hash-password",
# replace YOUR_USER and YOUR_PASSWORD_HASH, and add "import locked" to the /api/* and /measure/*
# blocks below. Only the data is locked; the web app files stay public (they are public on GitHub
# too), so the landing page opens and the phone can load the manifest and install the app.
(locked) {
	basic_auth {
		YOUR_USER YOUR_PASSWORD_HASH
	}
}

YOUR_NAME.duckdns.org {
	encode zstd gzip

	# The measurement server accepts at most 16 MB per request.
	request_body {
		max_size 20MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# The prefix is removed: the measurement server serves /v1/... and /health.
	handle_path /measure/* {
		import login
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		root * /var/www/sunsync
		# A new deployment must reach phones at once, so the app shell is never cached.
		@shell path / /index.html /sw.js
		header @shell Cache-Control "no-store, no-cache, must-revalidate"
		# Files with a fixed name may change at any time: ask the server before using a stored copy.
		@fixed path /manifest.webmanifest /design/* /icons/*
		header @fixed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
